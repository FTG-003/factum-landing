---
// === Index (v2) — Landing page dual-core industrial-tech ===
// Architettura: Navbar → HeroSplit → DualCoreWorkflow → Pricing → Footer
// Zero sezioni superflue, zero AI-slop, zero glass

import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import HeroSplit from "../components/HeroSplit.astro";
import DualCoreWorkflow from "../components/DualCoreWorkflow.astro";
import PricingTable from "../components/PricingTable.astro";

import {
  curlSnippet,
  pythonSnippet,
  responseSnippet,
  cliHelpSnippet,
  cliUsageSnippet,
  sdixmlSnippet,
} from "../data/snippets";
import {
  factumApiTiers,
  factumFicTiers,
} from "../data/pricing";
---

<Base
  title="Factum — AI Document Parser & factum-fic CLI per forfettari"
  description="Parsing e analisi logica per agenti IA. Gestione contabile forfettari via CLI. Zero compromessi, zero retention, zero cazzate."
>
  <Navbar />

  <!-- ═══ 1. HERO DUAL-CORE ═══ -->
  <HeroSplit
    curlSnippet={curlSnippet}
    pythonSnippet={pythonSnippet}
    responseSnippet={responseSnippet}
    cliHelpSnippet={cliHelpSnippet}
    cliUsageSnippet={cliUsageSnippet}
    xmlSnippet={sdixmlSnippet}
  />

  <!-- ═══ 2. WORKFLOW UNIFICATO (Pipeline + Flow + Privacy) ═══ -->
  <DualCoreWorkflow />

  <!-- ═══ 3. PRICING ═══ -->
  <PricingTable apiTiers={factumApiTiers} ficTiers={factumFicTiers} />

  <!-- ═══ 4. CTA FINALE (inline) ═══ -->
  <section class="border-t border-zinc-800 py-20">
    <div class="mx-auto max-w-3xl px-6 text-center lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-zinc-100">
        Provare costa zero secondi
      </h2>
      <p class="mt-3 text-sm text-zinc-500">
        Chiave API gratuita subito. CLI installata in 30 secondi.
        Se non funziona, non hai perso niente. Se funziona, ti cambia la giornata.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="https://pyragogy.lemonsqueezy.com/checkout/buy/d616a09d-75b3-48de-b41b-d2cc19589333"
          class="inline-flex items-center gap-2 rounded-lg bg-factum-400 px-5 py-2.5 font-mono text-sm font-semibold text-[#0a0e14] transition-all hover:bg-factum-300"
        >
          Ottieni API Key gratuita
        </a>
        <button
          class="inline-flex items-center gap-2 rounded-lg border border-zinc-800 px-5 py-2.5 font-mono text-sm text-zinc-400 transition-all hover:border-zinc-600 hover:text-zinc-200"
          @click="
            navigator.clipboard.writeText('pipx install git+https://github.com/FTG-003/factum-fic');
            $el.innerHTML = '&checkmark; Copiato! Incolla nel terminale';
            setTimeout(() => $el.innerHTML = '&#x1f4cb; Copia: pipx install', 2500);
          "
        >
          <span>&#x1f4cb;</span> Copia comando installazione
        </button>
      </div>
      <p class="mt-6 font-mono text-xs text-zinc-600">
        AGPL-3.0 &middot;
        <a href="https://github.com/FTG-003/factum-fic" class="underline hover:text-zinc-400">GitHub</a>
        &middot;
        <a href="https://docs.factum.pyragogy.org" class="underline hover:text-zinc-400">Documentazione</a>
      </p>
    </div>
  </section>
</Base>