---
// === CodeBlock — Terminal-style, emerald highlights ===

export interface Props {
  code: string;
  lang?: string;
  title?: string;
  compact?: boolean;
}

const { code, lang = "bash", title, compact = false } = Astro.props;

function escapeHtml(str: string): string {
  return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

function highlightLine(line: string): string {
  const trimmed = line.replace(/\s+$/, "");
  if (!trimmed) return "";

  if (trimmed.startsWith("#") || trimmed.startsWith("//")) {
    return `<span class="text-zinc-600">${escapeHtml(trimmed)}</span>`;
  }

  if (trimmed.startsWith("$")) {
    const prompt = '<span class="text-factum-400 select-none">$</span>';
    const rest = processInline(escapeHtml(trimmed.slice(1)));
    return `${prompt}${rest}`;
  }

  return processInline(escapeHtml(trimmed));
}

function processInline(text: string): string {
  let s = text.replace(/(https?:\/\/[^\s<]+)/g, '<span class="text-factum-300 underline decoration-factum-500/30">$1</span>');
  s = s.replace(/`([^`]+)`/g, '<span class="text-factum-400">$1</span>');
  if (lang === "json") {
    s = s.replace(/"([^"]+)":/g, '<span class="text-zinc-300">"$1"</span>:');
  }
  s = s.replace(/\b(\d+[.,]?\d*)\b/g, '<span class="text-factum-400">$1</span>');
  return s;
}

const highlighted = code.split("\n").map(highlightLine).join("\n");
---

<div class="group relative overflow-hidden rounded-2xl border border-zinc-800/60 bg-deep-900/80 font-mono text-sm transition-all duration-300 hover:border-zinc-700/80">
  {title && (
    <div class="flex items-center gap-3 border-b border-zinc-800/60 px-5 py-2.5">
      <div class="flex gap-1.5">
        <span class="h-2.5 w-2.5 rounded-full bg-red-500/60" />
        <span class="h-2.5 w-2.5 rounded-full bg-yellow-500/60" />
        <span class="h-2.5 w-2.5 rounded-full bg-factum-400/60" />
      </div>
      <span class="text-sm text-zinc-500">{title}</span>
      <span class="ml-auto text-xs uppercase tracking-wider text-zinc-600">{lang}</span>
    </div>
  )}
  <div class="overflow-x-auto terminal-scrollbar" class:list={{ "p-5": !compact, "p-3": compact }}>
    <pre class="leading-relaxed"><code class="text-sm" set:html={highlighted} /></pre>
  </div>
</div>