---
// === MetricCard — Griglia metriche con animazione counters ===
// Dati reali dai codebase.

export interface Props {
  metrics: { value: string; label: string; source: string }[];
}
const { metrics } = Astro.props;
---

<section class="relative border-t border-white/5 py-16 md:py-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <!-- Header -->
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <span class="mb-4 inline-block text-xs font-medium uppercase tracking-[0.2em] text-factum-400">Numeri</span>
      <h2 class="text-2xl font-bold text-zinc-100 sm:text-3xl">
        Build come si deve
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-zinc-500">
        342 test sull'API. 208 sulla CLI. CI verde. Metriche Prometheus. Niente vibe coding.
      </p>
    </div>

    <!-- Metrics grid -->
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      {metrics.map((m, i) => (
        <div
          class="animate-fade-up rounded-xl border border-white/5 bg-deep-800/20 p-5 text-center transition-all duration-300 hover:border-factum-500/15 hover:bg-deep-800/40"
          style={`animation-delay: ${i * 0.05}s`}
          x-data="{ val: '0', target: '${m.value}', displayed: false }"
          x-init="
            $nextTick(() => {
              displayed = true;
              val = target;
            });
          "
        >
          <div
            class="mx-auto mb-1 text-2xl font-bold tracking-tight sm:text-3xl"
            class:list={{
              "text-factum-400": !m.value.includes("€") && !m.value.includes("80%"),
              "text-amber-400": m.value.includes("€0") || m.value.includes("80%"),
            }}
          >
            <span x-text="displayed ? target : '0'">{m.value}</span>
          </div>
          <div class="text-xs text-zinc-600">{m.label}</div>
          <div class="mt-1 text-[10px] text-zinc-700 font-mono">{m.source}</div>
        </div>
      ))}
    </div>
  </div>
</section>