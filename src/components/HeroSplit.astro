---
// === HeroSplit — Dual-Core: Factum API vs factum-fic ===
// Big headline, big cards, big energy

import CodeBlock from "./CodeBlock.astro";

export interface Props {
  curlSnippet: string;
  pythonSnippet: string;
  responseSnippet: string;
  cliHelpSnippet: string;
  cliUsageSnippet: string;
  xmlSnippet: string;
}
const { curlSnippet, pythonSnippet, responseSnippet, cliHelpSnippet, cliUsageSnippet, xmlSnippet } = Astro.props;
---

<section class="relative min-h-[calc(100vh-4rem)] pt-32 md:pt-44">
  <div class="pointer-events-none absolute inset-0 bg-geo opacity-30" aria-hidden="true" />

  <div class="relative mx-auto max-w-7xl px-6 pb-24 lg:px-8">
    <!-- Headline — Fraunces grande, emerald accent -->
    <div class="mx-auto mb-20 max-w-5xl text-center">
      <span class="mb-6 inline-block font-mono text-xs font-medium uppercase tracking-[0.3em] text-zinc-600">
        Factum
      </span>
      <h1 class="font-serif-display text-4xl leading-[1.1] tracking-tight sm:text-5xl md:text-6xl lg:text-7xl">
        <span class="text-zinc-100">Parsing che capisce.</span>
        <br />
        <span class="text-factum-400">Contabilità che non rompe.</span>
      </h1>
      <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-zinc-500">
        <span class="font-medium text-zinc-300">Factum API</span> per dare intelligenza documentale ai tuoi
        agenti AI. <span class="font-medium text-zinc-300">factum-fic</span> per liberare i forfettari dalla
        burocrazia delle fatture estere.
      </p>

      <!-- Infografica sotto l'headline -->
      <div class="mx-auto mt-10 max-w-5xl">
        <img
          src="/og-image.webp"
          alt="Factum Architecture: documenti → API/CLI → Envelope JSON strutturato"
          class="w-full rounded-2xl border border-zinc-800/60"
          width="1200"
          height="630"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>

      <!-- Dual columns — big gap -->
    <div class="grid gap-8 lg:grid-cols-2 lg:gap-10">
      <!-- ── SX: FACTUM API ── -->
      <div
        class="animate-fade-up rounded-2xl border border-zinc-800/60 bg-deep-800 p-6 sm:p-8"
        style="animation-delay: 0.05s"
        x-data="{ apiTab: 'curl' }"
      >
        <div class="mb-6 flex items-start justify-between">
          <div>
            <div class="mb-2 flex items-center gap-2">
              <span class="flex h-6 w-6 items-center justify-center rounded border border-factum-400/30 text-xs font-bold text-factum-400 font-mono">A</span>
              <span class="font-mono text-xs font-semibold uppercase tracking-wider text-factum-400">Factum API</span>
            </div>
            <h2 class="text-xl font-bold text-zinc-100 sm:text-2xl">AI Document Parser</h2>
            <p class="mt-1 text-sm text-zinc-500">FatturaPA · PDF · F24 · fatture SaaS</p>
          </div>
          <div class="shrink-0 text-right">
            <div class="text-xl sm:text-2xl font-bold tracking-tight text-factum-400 font-mono">41 ms</div>
            <div class="text-[10px] sm:text-xs font-mono uppercase tracking-wider text-zinc-600">fast-path</div>
          </div>
        </div>

        <!-- Tab bar -->
        <div class="mb-4 flex gap-1 rounded-xl border border-zinc-800 bg-deep-900 p-1">
          <button class="flex-1 rounded-lg px-4 py-2 text-xs font-mono font-medium transition-all"
            :class="apiTab === 'curl' ? 'bg-zinc-800 text-zinc-100 border border-zinc-700' : 'text-zinc-600 hover:text-zinc-400'"
            @click="apiTab = 'curl'">cURL</button>
          <button class="flex-1 rounded-lg px-4 py-2 text-xs font-mono font-medium transition-all"
            :class="apiTab === 'python' ? 'bg-zinc-800 text-zinc-100 border border-zinc-700' : 'text-zinc-600 hover:text-zinc-400'"
            @click="apiTab = 'python'">Python</button>
          <button class="flex-1 rounded-lg px-4 py-2 text-xs font-mono font-medium transition-all"
            :class="apiTab === 'response' ? 'bg-zinc-800 text-zinc-100 border border-zinc-700' : 'text-zinc-600 hover:text-zinc-400'"
            @click="apiTab = 'response'">JSON</button>
        </div>

        <div x-show="apiTab === 'curl'" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0">
          <CodeBlock code={curlSnippet} lang="bash" title="POST /v1/parse" />
        </div>
        <div x-show="apiTab === 'python'" x-cloak x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0">
          <CodeBlock code={pythonSnippet} lang="python" title="httpx async" />
        </div>
        <div x-show="apiTab === 'response'" x-cloak x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0">
          <CodeBlock code={responseSnippet} lang="json" title="Envelope v2" />
        </div>

        <div class="mt-6 flex items-center gap-4">
          <a href="https://docs.factum.pyragogy.org" class="font-mono text-sm font-medium text-factum-400 transition-colors hover:text-factum-300">Documentazione →</a>
          <a href="https://pyragogy.lemonsqueezy.com/checkout/buy/d616a09d-75b3-48de-b41b-d2cc19589333"
             class="ml-auto inline-flex items-center gap-1.5 rounded-xl border border-zinc-800 px-5 py-2.5 font-mono text-sm text-zinc-300 transition-all hover:border-zinc-600 hover:text-zinc-100">Free API Key</a>
        </div>
      </div>

      <!-- ── DX: FACTUM-FIC CLI ── -->
      <div
        class="animate-fade-up rounded-2xl border border-zinc-800/60 bg-deep-800 p-6 sm:p-8"
        style="animation-delay: 0.12s"
        x-data="{ cliTab: 'help' }"
      >
        <div class="mb-6 flex items-start justify-between">
          <div>
            <div class="mb-2 flex items-center gap-2">
              <span class="flex h-6 w-6 items-center justify-center rounded border border-factum-400/30 text-xs font-bold text-factum-400 font-mono">F</span>
              <span class="font-mono text-xs font-semibold uppercase tracking-wider text-factum-400">factum-fic</span>
            </div>
            <h2 class="text-xl font-bold text-zinc-100 sm:text-2xl">CLI Contabile Forfettari</h2>
            <p class="mt-1 text-sm text-zinc-500">Open Source · AGPL-3.0 · 208 test</p>
          </div>
          <div class="shrink-0 text-right">
            <div class="text-xl sm:text-2xl font-bold tracking-tight text-factum-400 font-mono">€0</div>
            <div class="text-[10px] sm:text-xs font-mono uppercase tracking-wider text-zinc-600">10 PDF/mese</div>
          </div>
        </div>

        <!-- Tab bar -->
        <div class="mb-4 flex gap-1 rounded-xl border border-zinc-800 bg-deep-900 p-1">
          <button class="flex-1 rounded-lg px-4 py-2 text-xs font-mono font-medium transition-all"
            :class="cliTab === 'help' ? 'bg-zinc-800 text-zinc-100 border border-zinc-700' : 'text-zinc-600 hover:text-zinc-400'"
            @click="cliTab = 'help'">--help</button>
          <button class="flex-1 rounded-lg px-4 py-2 text-xs font-mono font-medium transition-all"
            :class="cliTab === 'quickstart' ? 'bg-zinc-800 text-zinc-100 border border-zinc-700' : 'text-zinc-600 hover:text-zinc-400'"
            @click="cliTab = 'quickstart'">Quickstart</button>
          <button class="flex-1 rounded-lg px-4 py-2 text-xs font-mono font-medium transition-all"
            :class="cliTab === 'xml' ? 'bg-zinc-800 text-zinc-100 border border-zinc-700' : 'text-zinc-600 hover:text-zinc-400'"
            @click="cliTab = 'xml'">XML SDI</button>
        </div>

        <div x-show="cliTab === 'help'" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0">
          <CodeBlock code={cliHelpSnippet} lang="bash" title="$ factum-fic --help" />
        </div>
        <div x-show="cliTab === 'quickstart'" x-cloak x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0">
          <CodeBlock code={cliUsageSnippet} lang="bash" title="Quickstart" />
        </div>
        <div x-show="cliTab === 'xml'" x-cloak x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0">
          <CodeBlock code={xmlSnippet} lang="xml" title="FatturaPA XML" />
        </div>

        <div class="mt-6 flex items-center gap-4">
          <a href="https://github.com/FTG-003/factum-fic" class="font-mono text-sm font-medium text-factum-400 transition-colors hover:text-factum-300">GitHub →</a>
          <button
            class="ml-auto inline-flex items-center gap-1.5 rounded-xl border border-zinc-800 px-5 py-2.5 font-mono text-sm text-zinc-300 transition-all hover:border-zinc-600 hover:text-zinc-100"
            @click="
              navigator.clipboard.writeText('pipx install git+https://github.com/FTG-003/factum-fic');
              $el.innerHTML = '✅ Copiato!';
              setTimeout(() => $el.innerHTML = 'pipx install →', 2000);
            "
          >pipx install →</button>
        </div>
      </div>
    </div>
  </div>
</section>