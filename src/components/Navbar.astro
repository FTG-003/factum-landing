---
// === Navbar (v2) — Fissa, border zinc-800, pulita, zero glass ===
// Link rapidi: Docs · GitHub · Pricing + CTA doppie

export interface Props {
  showPricing?: boolean;
}
const { showPricing = true } = Astro.props;
---

<nav
  class="fixed left-0 right-0 top-0 z-50 border-b border-zinc-800 bg-[#0a0a0a]"
  x-data="{ mobileOpen: false }"
>
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-6 lg:px-8">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 text-base font-bold tracking-tight transition-opacity hover:opacity-80">
      <svg width="22" height="22" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
        <rect x="2" y="2" width="24" height="24" rx="6" stroke="currentColor" stroke-width="2" class="text-factum-400"/>
        <path d="M9 14h10M14 9v10" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-factum-400"/>
      </svg>
      <span class="font-mono text-sm text-factum-400">factum</span>
      <span class="hidden font-mono text-[11px] text-zinc-600 sm:inline">/pyragogy</span>
    </a>

    <!-- Desktop links -->
    <div class="hidden items-center gap-6 md:flex">
      <a href="https://docs.factum.pyragogy.org" class="font-mono text-[13px] text-zinc-500 transition-colors hover:text-zinc-200">Docs</a>
      <a href="https://github.com/FTG-003/factum-fic" class="font-mono text-[13px] text-zinc-500 transition-colors hover:text-zinc-200">GitHub</a>
      {showPricing && (
        <a href="#pricing" class="font-mono text-[13px] text-zinc-500 transition-colors hover:text-zinc-200">Prezzi</a>
      )}

      <div class="flex items-center gap-2">
        <a
          href="https://pyragogy.lemonsqueezy.com/checkout/buy/d616a09d-75b3-48de-b41b-d2cc19589333"
          class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-800 px-3.5 py-1.5 font-mono text-[13px] text-zinc-400 transition-all hover:border-zinc-600 hover:text-zinc-200"
        >
          API Key
        </a>
        <a
          href="#cli"
          class="inline-flex items-center gap-1.5 rounded-lg bg-factum-400/10 px-3.5 py-1.5 font-mono text-[13px] text-factum-400 transition-all hover:bg-factum-400/20"
        >
          Installa CLI
        </a>
      </div>
    </div>

    <!-- Mobile hamburger -->
    <button class="text-zinc-500 md:hidden" @click="mobileOpen = !mobileOpen" aria-label="Menu">
      <svg x-show="!mobileOpen" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <svg x-show="mobileOpen" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    class="border-t border-zinc-800 bg-[#0a0a0a] md:hidden"
    x-show="mobileOpen"
    x-cloak
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-4"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-4"
  >
    <div class="space-y-1 px-6 py-4">
      <a href="https://docs.factum.pyragogy.org" class="block rounded-lg px-3 py-2 font-mono text-sm text-zinc-500 hover:bg-zinc-900 hover:text-zinc-200" @click="mobileOpen = false">Docs</a>
      <a href="https://github.com/FTG-003/factum-fic" class="block rounded-lg px-3 py-2 font-mono text-sm text-zinc-500 hover:bg-zinc-900 hover:text-zinc-200" @click="mobileOpen = false">GitHub</a>
      {showPricing && (
        <a href="#pricing" class="block rounded-lg px-3 py-2 font-mono text-sm text-zinc-500 hover:bg-zinc-900 hover:text-zinc-200" @click="mobileOpen = false">Prezzi</a>
      )}
      <hr class="my-3 border-zinc-800" />
      <a href="https://pyragogy.lemonsqueezy.com/checkout/buy/d616a09d-75b3-48de-b41b-d2cc19589333" class="flex items-center gap-2 rounded-lg border border-zinc-800 px-3 py-2 font-mono text-sm text-zinc-400" @click="mobileOpen = false">API Key</a>
      <a href="#cli" class="flex items-center gap-2 rounded-lg bg-factum-400/10 px-3 py-2 font-mono text-sm text-factum-400" @click="mobileOpen = false">Installa CLI</a>
    </div>
  </div>
</nav>