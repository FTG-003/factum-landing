---
// === Navbar — Sticky con backdrop blur, link e CTA ===

export interface Props {
  showPricing?: boolean;
}
const { showPricing = true } = Astro.props;
---

<nav
  class="fixed left-0 right-0 top-0 z-50 border-b border-white/5 bg-deep-900/70 backdrop-blur-xl"
  x-data="{ mobileOpen: false }"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6 lg:px-8">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight transition-opacity hover:opacity-80">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
        <rect x="2" y="2" width="24" height="24" rx="6" stroke="currentColor" stroke-width="2" class="text-factum-400"/>
        <path d="M9 14h10M14 9v10" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-factum-400"/>
      </svg>
      <span class="font-mono text-factum-400">factum</span>
      <span class="hidden text-zinc-500 sm:inline font-mono text-xs">/pyragogy</span>
    </a>

    <!-- Desktop links -->
    <div class="hidden items-center gap-8 md:flex">
      <a
        href="https://docs.factum.pyragogy.org"
        class="text-sm text-zinc-400 transition-colors hover:text-zinc-100"
      >
        Documentazione
      </a>
      <a
        href="https://github.com/FTG-003/factum-fic"
        class="text-sm text-zinc-400 transition-colors hover:text-zinc-100"
      >
        GitHub
      </a>
      {showPricing && (
        <a href="#pricing" class="text-sm text-zinc-400 transition-colors hover:text-zinc-100">
          Prezzi
        </a>
      )}

      <!-- CTA buttons -->
      <div class="flex items-center gap-3">
        <a
          href="https://pyragogy.lemonsqueezy.com/checkout/buy/d616a09d-75b3-48de-b41b-d2cc19589333"
          class="inline-flex items-center gap-1.5 rounded-lg border border-white/10 px-4 py-2 text-sm font-medium text-zinc-300 transition-all hover:border-factum-500/40 hover:text-factum-300 glass-hover"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z"/>
          </svg>
          API Key
        </a>
        <a
          href="#cli"
          class="inline-flex items-center gap-1.5 rounded-lg bg-factum-500/10 px-4 py-2 text-sm font-medium text-factum-300 transition-all hover:bg-factum-500/20 border border-factum-500/20"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z"/>
          </svg>
          Installa CLI
        </a>
      </div>
    </div>

    <!-- Mobile hamburger -->
    <button
      class="text-zinc-400 md:hidden"
      @click="mobileOpen = !mobileOpen"
      aria-label="Menu"
    >
      <svg x-show="!mobileOpen" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
      </svg>
      <svg x-show="mobileOpen" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    class="border-t border-white/5 bg-deep-900/95 backdrop-blur-xl md:hidden"
    x-show="mobileOpen"
    x-cloak
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-4"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-4"
  >
    <div class="space-y-1 px-6 py-4">
      <a href="https://docs.factum.pyragogy.org" class="block rounded-lg px-3 py-2 text-sm text-zinc-400 hover:bg-white/5 hover:text-zinc-100" @click="mobileOpen = false">Documentazione</a>
      <a href="https://github.com/FTG-003/factum-fic" class="block rounded-lg px-3 py-2 text-sm text-zinc-400 hover:bg-white/5 hover:text-zinc-100" @click="mobileOpen = false">GitHub</a>
      {showPricing && (
        <a href="#pricing" class="block rounded-lg px-3 py-2 text-sm text-zinc-400 hover:bg-white/5 hover:text-zinc-100" @click="mobileOpen = false">Prezzi</a>
      )}
      <hr class="my-3 border-white/5" />
      <a href="https://pyragogy.lemonsqueezy.com/checkout/buy/d616a09d-75b3-48de-b41b-d2cc19589333" class="flex items-center gap-2 rounded-lg border border-white/10 px-3 py-2 text-sm text-zinc-300" @click="mobileOpen = false">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z"/></svg>
        API Key
      </a>
      <a href="#cli" class="flex items-center gap-2 rounded-lg bg-factum-500/10 px-3 py-2 text-sm text-factum-300" @click="mobileOpen = false">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z"/></svg>
        Installa CLI
      </a>
    </div>
  </div>
</nav>

<style>
  [x-cloak] { display: none !important; }
</style>