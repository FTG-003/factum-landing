---
// === DualCoreWorkflow — 3 tab: Pipeline · Workflow · Privacy ===
// Big cards, big spacing, emerald accents, high contrast

const apiStages = [
  { num: 1, name: "Detect", detail: "Sniff MIME + SHA-256 dedup", metric: "classifica documento" },
  { num: 2, name: "Extract", detail: "PyMuPDF · 12s timeout · fail-open", metric: "≤ 12s" },
  { num: 3, name: "PII Sidecar", detail: "Rizzo 0.3B · pseudonimizza prima dell'LLM", metric: "ZDR", accent: true },
  { num: 4, name: "LLM Cascade", detail: "DeepSeek Flash→Claude Sonnet · cost guard", metric: "€0 provider" },
  { num: 5, name: "Quality Gate", detail: "Confidence score · HITL triage soglia", metric: "97%+" },
  { num: 6, name: "Envelope", detail: "v2 strutturato · schema_version · payload", metric: "JSON" },
];

const cliSteps = [
  { icon: "📥", title: "Drop", desc: "Trascini PDF/XML in da_elaborare/", detail: "SHA-256 dedup · watchdog" },
  { icon: "🔍", title: "Extract", desc: "Testo estratto in locale (pypdf)", detail: "XML: 100% locale · PDF: solo testo" },
  { icon: "⚙️", title: "Parse", desc: "Factum Parse API analizza", detail: "Fast-path XML 41ms · LLM per PDF" },
  { icon: "🗺️", title: "Map", desc: "Mapper fiscale · conversione valuta", detail: "Categorie FIC · reverse charge" },
  { icon: "☁️", title: "FIC", desc: "Registrazione su Fatture in Cloud", detail: "Create expense + PDF allegato" },
  { icon: "📄", title: "SDI", desc: "Autofattura in bozza (se estera)", detail: "TD17 · TD18 · TD19 automatico" },
];

const metrics = [
  { val: "41 ms", label: "Fast-path P50", src: "fastpath.py" },
  { val: "342+", label: "Test API", src: "README.md" },
  { val: "0,16 ms", label: "In-process P50", src: "main.py" },
  { val: "97%+", label: "Confidence avg", src: "envelope_v2" },
];
---

<section class="relative border-t border-zinc-800/60 py-28 md:py-36"
  x-data="{ tab: 'pipeline' }">
  <div class="pointer-events-none absolute inset-0 bg-geo opacity-30" aria-hidden="true" />

  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
    <!-- Section header -->
    <div class="mx-auto mb-14 max-w-3xl text-center">
      <span class="mb-4 inline-block font-mono text-xs font-medium uppercase tracking-[0.3em] text-factum-400">/workflow</span>
      <h2 class="font-serif-display text-4xl text-zinc-100 sm:text-5xl">Dal file al risultato</h2>
      <p class="mt-4 text-base leading-relaxed text-zinc-500">
        Due pipeline indipendenti. Una logica comune. Scegli il flusso che ti interessa.
      </p>
    </div>

    <!-- Tab bar — larger -->
    <div class="mx-auto mb-14 flex max-w-xl border border-zinc-800 rounded-2xl p-1.5 bg-deep-800">
      <button class="flex-1 rounded-xl px-5 py-3 text-center text-base font-medium font-mono transition-all"
        :class="tab === 'pipeline' ? 'bg-zinc-800 text-zinc-100 border border-zinc-700' : 'text-zinc-500 hover:text-zinc-300 border border-transparent'"
        @click="tab = 'pipeline'">⚡ API Pipeline</button>
      <button class="flex-1 rounded-xl px-5 py-3 text-center text-base font-medium font-mono transition-all"
        :class="tab === 'workflow' ? 'bg-zinc-800 text-zinc-100 border border-zinc-700' : 'text-zinc-500 hover:text-zinc-300 border border-transparent'"
        @click="tab = 'workflow'">📁 CLI Workflow</button>
      <button class="flex-1 rounded-xl px-5 py-3 text-center text-base font-medium font-mono transition-all"
        :class="tab === 'privacy' ? 'bg-zinc-800 text-zinc-100 border border-zinc-700' : 'text-zinc-500 hover:text-zinc-300 border border-transparent'"
        @click="tab = 'privacy'">🔒 Privacy</button>
    </div>

    <!-- ═══ TAB 1: PIPELINE ═══ -->
    <div x-show="tab === 'pipeline'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4">

      <div class="mx-auto mb-10 max-w-4xl rounded-2xl border border-zinc-800/60 bg-deep-800 px-6 py-4 text-center">
        <p class="text-base text-zinc-400 font-mono">
          <span class="text-factum-400 font-semibold">⚡ Fast-path XML:</span> Detect → Envelope.
          <span class="text-zinc-300">41 ms · €0 · confidence 1.0</span>
        </p>
      </div>

      <!-- Pipeline grid -->
      <div class="relative grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
        <div class="absolute inset-x-0 top-1/2 hidden h-px bg-zinc-800 xl:block" aria-hidden="true" />
        {apiStages.map((s) => (
          <div class="group rounded-2xl border bg-deep-800 p-6 transition-all duration-200 hover:-translate-y-1"
            class:list={{
              "border-zinc-800/60 hover:border-zinc-600": !s.accent,
              "border-emerald-900/40 hover:border-emerald-700/60": s.accent,
            }}>
            <div class="mb-4 flex items-center justify-between">
              <span class="flex h-7 w-7 items-center justify-center rounded-full text-sm font-bold font-mono"
                class:list={{"bg-zinc-800 text-zinc-400": !s.accent, "bg-emerald-900/40 text-factum-400": s.accent}}>
                {s.num}
              </span>
              <span class="text-xs font-mono uppercase tracking-wider"
                class:list={{"text-zinc-600": !s.accent, "text-factum-400/70": s.accent}}>
                {s.metric}
              </span>
            </div>
            <h4 class="mb-1.5 text-base font-semibold text-zinc-100">{s.name}</h4>
            <p class="text-sm leading-relaxed text-zinc-500">{s.detail}</p>
          </div>
        ))}
      </div>

      <!-- Bigger metrics row -->
      <div class="mx-auto mt-10 grid max-w-4xl grid-cols-4 gap-5">
        {metrics.map((m, i) => (
          <div class="animate-fade-up rounded-2xl border border-zinc-800/60 bg-deep-800 p-6 text-center"
            style={`animation-delay: ${0.2 + i * 0.06}s`}>
            <div class="text-2xl font-bold tracking-tight text-factum-400 font-mono">{m.val}</div>
            <div class="text-sm text-zinc-500 mt-1">{m.label}</div>
            <div class="text-xs font-mono text-zinc-700 mt-1">{m.src}</div>
          </div>
        ))}
      </div>

      <div class="mx-auto mt-8 max-w-3xl animate-fade-up rounded-2xl border border-zinc-800/60 bg-deep-800 p-5" style="animation-delay: 0.5s">
        <div class="flex items-center gap-3 text-sm font-mono text-zinc-500">
          <span class="text-factum-400">$</span> factum-fic setup → configura → elabora → fatto
          <span class="ml-auto hidden rounded-full bg-zinc-800/60 px-3 py-1 text-xs text-zinc-500 sm:inline">
            sotto: <button class="text-factum-400 underline underline-offset-2" @click="tab = 'workflow'">📁 CLI Workflow</button>
          </span>
        </div>
      </div>
    </div>

    <!-- ═══ TAB 2: CLI WORKFLOW ═══ -->
    <div x-show="tab === 'workflow'" x-cloak x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4">
      <div class="mx-auto max-w-5xl space-y-4">
        {cliSteps.map((s, i) => (
          <div class="animate-fade-up rounded-2xl border border-zinc-800/60 bg-deep-800 p-6 transition-all duration-200 hover:border-zinc-600 md:flex md:items-center md:gap-6"
            style={`animation-delay: ${i * 0.07}s`}>
            <div class="mb-4 flex items-center gap-4 md:mb-0 md:flex-col md:items-center">
              <span class="flex h-12 w-12 items-center justify-center rounded-xl border border-zinc-800 bg-zinc-900 text-xl">{s.icon}</span>
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-zinc-800 text-xs font-bold text-zinc-400 font-mono md:hidden">{i + 1}</span>
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center justify-between gap-3">
                <h3 class="text-lg font-semibold text-zinc-100">{s.title}</h3>
                <span class="hidden shrink-0 rounded-full bg-zinc-800/60 px-3 py-1 text-xs font-mono text-zinc-500 md:inline">{s.detail}</span>
              </div>
              <p class="mt-1 text-base text-zinc-400">{s.desc}</p>
            </div>
            <span class="mt-3 inline-block rounded-full bg-zinc-800/60 px-3 py-1 text-xs font-mono text-zinc-500 md:hidden">{s.detail}</span>
          </div>
        ))}
      </div>

      <!-- Terminal output — bigger -->
      <div class="mx-auto mt-10 max-w-3xl animate-fade-up rounded-2xl border border-zinc-800/60 overflow-hidden" style="animation-delay: 0.55s">
        <div class="flex items-center gap-2 border-b border-zinc-800/60 bg-deep-900 px-5 py-3">
          <span class="h-3 w-3 rounded-full bg-zinc-700" />
          <span class="h-3 w-3 rounded-full bg-zinc-700" />
          <span class="h-3 w-3 rounded-full bg-zinc-700" />
          <span class="ml-3 font-mono text-sm text-zinc-600">factum-fic sync</span>
          <span class="ml-auto font-mono text-xs text-zinc-600">bash</span>
        </div>
        <div class="bg-[#06080d] p-6 font-mono text-sm leading-relaxed">
          <p><span class="text-factum-400 select-none">$</span><span class="text-zinc-600"> factum-fic</span> sync --dir ./da_elaborare/</p>
          <p class="mt-2"><span class="text-factum-400">✓</span> <span class="text-zinc-300">INV-001.pdf</span> <span class="text-zinc-600">→ estratto (2.3s)</span></p>
          <p><span class="text-factum-400">✓</span> <span class="text-zinc-300">INV-002-US.pdf</span> <span class="text-zinc-600">→ mappato USD→EUR (1.18)</span></p>
          <p><span class="text-factum-400">✓</span> <span class="text-zinc-300">Hetzner-2026-08.xml</span> <span class="text-zinc-600">→ fast-path (41ms)</span></p>
          <p class="mt-2 text-zinc-700">───</p>
          <p><span class="text-factum-400 font-semibold">✅</span> <span class="text-zinc-100">3 spese registrate su Fatture in Cloud</span></p>
          <p><span class="text-amber-400">📄</span> <span class="text-zinc-100">1 autofattura TD18 in bozza (Hetzner GmbH, DE)</span></p>
          <p class="mt-1 text-zinc-600">File spostati in archiviate/2026/08/</p>
        </div>
      </div>

      <!-- Command grid -->
      <div class="mx-auto mt-12 max-w-4xl">
        <h3 class="mb-6 text-center font-mono text-sm font-semibold uppercase tracking-wider text-zinc-500">Comandi (tutti in 🇮🇹)</h3>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
          {[
            { cmd: "configura", alias: "setup", desc: "Configurazione guidata" },
            { cmd: "elabora", alias: "sync", desc: "Elabora tutti i file" },
            { cmd: "auto", alias: "watch", desc: "Elaborazione automatica" },
            { cmd: "stato", alias: "status", desc: "Dashboard operativo" },
            { cmd: "ricarica", alias: "buy-credits", desc: "Acquista 100 PDF" },
            { cmd: "riprova-autofatture", alias: "retry", desc: "Recupera fallite" },
          ].map((c) => (
            <div class="rounded-2xl border border-zinc-800/60 bg-deep-800 p-4 text-center transition-colors hover:border-zinc-600">
              <div class="font-mono text-base text-factum-400 font-semibold">factum-fic {c.cmd}</div>
              <div class="mt-1 text-sm text-zinc-600">{c.desc}</div>
              <div class="mt-1 text-xs font-mono text-zinc-600">alias: <span class="text-zinc-500">{c.alias}</span></div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- ═══ TAB 3: PRIVACY ═══ -->
    <div x-show="tab === 'privacy'" x-cloak x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-6 md:grid-cols-3">
          <div class="animate-fade-up rounded-2xl border border-zinc-800/60 bg-deep-800 p-8" style="animation-delay: 0s">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl border border-zinc-800 bg-zinc-900 text-xl">🔒</div>
            <h3 class="mb-3 text-lg font-semibold text-zinc-100">Zero Data Retention</h3>
            <p class="text-sm leading-relaxed text-zinc-500">
              Il mapping PII vive in <span class="font-mono text-zinc-300">RAM</span> per-request.
              Droppato subito dopo la risposta. Mai sul DB. Direttiva A1: nessun risultato LLM persistito.
            </p>
          </div>
          <div class="animate-fade-up rounded-2xl border border-zinc-800/60 bg-deep-800 p-8" style="animation-delay: 0.07s">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl border border-zinc-800 bg-zinc-900 text-xl">🧠</div>
            <h3 class="mb-3 text-lg font-semibold text-zinc-100">Sidecar Rizzo 0.3B</h3>
            <p class="text-sm leading-relaxed text-zinc-500">
              Pseudonimizza <span class="text-zinc-300">nomi, P.IVA, indirizzi</span> prima che i dati
              tocchino DeepSeek o Claude. Solo placeholder <span class="font-mono text-zinc-600">[PERSONA_001]</span>.
            </p>
          </div>
          <div class="animate-fade-up rounded-2xl border border-zinc-800/60 bg-deep-800 p-8" style="animation-delay: 0.14s">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl border border-zinc-800 bg-zinc-900 text-xl">🛡️</div>
            <h3 class="mb-3 text-lg font-semibold text-zinc-100">Fail-closed</h3>
            <p class="text-sm leading-relaxed text-zinc-500">
              Sidecar giù → <span class="font-mono text-red-400">503</span>. Senza auth → <span class="font-mono text-red-400">401</span>.
              Immagini bloccate a <span class="font-mono text-red-400">422</span>.
            </p>
          </div>
        </div>

        <div class="mx-auto mt-8 max-w-4xl animate-fade-up rounded-2xl border border-zinc-800/60 bg-deep-800 p-6 text-center" style="animation-delay: 0.2s">
          <p class="text-base text-zinc-400">
            <span class="font-semibold text-zinc-200">📁 factum-fic:</span> XML elaborato <span class="font-mono text-zinc-300">100% in locale</span>.
            PDF invia solo testo via HTTPS. Mai memorizzato. Credenziali in <span class="font-mono text-zinc-600">.env</span>.
          </p>
        </div>

        <div class="mx-auto mt-6 max-w-md animate-fade-up rounded-2xl border border-zinc-800/60 bg-deep-800 p-6" style="animation-delay: 0.25s">
          <div class="grid grid-cols-3 gap-4 font-mono text-sm text-center">
            <div><span class="text-red-400 text-lg font-bold">503</span><br /><span class="text-zinc-600">Sidecar down</span></div>
            <div><span class="text-red-400 text-lg font-bold">422</span><br /><span class="text-zinc-600">Immagine</span></div>
            <div><span class="text-red-400 text-lg font-bold">401</span><br /><span class="text-zinc-600">No auth</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>