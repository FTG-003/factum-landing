---
// === PricingTable — Dual-column, big numbers, emerald ===

import type { PricingTier } from "../data/pricing";

export interface Props {
  apiTiers: PricingTier[];
  ficTiers: PricingTier[];
}
const { apiTiers, ficTiers } = Astro.props;
---

<section id="pricing" class="relative border-t border-zinc-800/60 py-28 md:py-36">
  <div class="pointer-events-none absolute inset-0 bg-geo opacity-20" aria-hidden="true" />

  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto mb-14 max-w-3xl text-center">
      <span class="mb-4 inline-block font-mono text-xs font-medium uppercase tracking-[0.3em] text-factum-400">/pricing</span>
      <h2 class="font-serif-display text-4xl text-zinc-100 sm:text-5xl">Paghi solo quello che usi</h2>
      <p class="mt-4 text-base leading-relaxed text-zinc-500">
        Niente abbonamenti nascosti. Niente sales call. Prezzi reali, uguali per tutti.
      </p>
    </div>

    <div class="grid gap-10 lg:grid-cols-2">
      <!-- ── FACTUM API ── -->
      <div>
        <div class="mb-6 flex items-center gap-3">
          <span class="flex h-7 w-7 items-center justify-center rounded border border-factum-400/30 text-sm font-bold text-factum-400 font-mono">A</span>
          <h3 class="font-mono text-lg font-semibold text-zinc-100">Factum API</h3>
          <span class="font-mono text-sm text-zinc-600">AI Document Parser</span>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          {apiTiers.map((tier, i) => (
            <div class="animate-fade-up flex flex-col rounded-2xl border p-6 transition-all duration-200"
              class:list={{
                "border-zinc-800/60 border-t-2 border-t-factum-400 bg-deep-800 shadow-sm shadow-factum-500/10": tier.highlighted,
                "border-zinc-800/60 bg-deep-800 hover:border-zinc-600": !tier.highlighted,
              }}
              style={`animation-delay: ${i * 0.07}s`}>
              {tier.badge && (
                <span class="mb-4 font-mono text-xs font-medium uppercase tracking-wider"
                  class:list={{"text-factum-400": tier.highlighted, "text-zinc-600": !tier.highlighted}}>
                  {tier.badge}
                </span>
              )}
              <h4 class="text-xl font-semibold text-zinc-100">{tier.name}</h4>
              <p class="text-sm text-zinc-600">{tier.subtitle}</p>
              <div class="my-4">
                <span class="text-3xl font-bold tracking-tight text-zinc-100 font-mono">{tier.price}</span>
                <span class="ml-1.5 text-sm text-zinc-600 font-mono">{tier.priceSuffix}</span>
              </div>
              <p class="mb-5 text-sm leading-relaxed text-zinc-500">{tier.description}</p>
              <ul class="mb-8 space-y-2.5 text-sm" role="list">
                {tier.features.map((f) => (
                  <li class="flex items-start gap-2.5 text-zinc-400">
                    <svg class="mt-0.5 h-4 w-4 shrink-0 text-factum-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
              <a href={tier.ctaHref}
                class="mt-auto inline-flex w-full items-center justify-center gap-1.5 rounded-xl py-2.5 text-center font-mono text-sm font-medium transition-all"
                class:list={{
                  "bg-factum-400 text-deep-900 hover:bg-factum-300 font-semibold": tier.highlighted,
                  "border border-zinc-800 text-zinc-400 hover:border-zinc-600 hover:text-zinc-200": !tier.highlighted,
                }}>
                {tier.cta}
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          ))}
        </div>
      </div>

      <!-- ── FACTUM-FIC ── -->
      <div>
        <div class="mb-6 flex items-center gap-3">
          <span class="flex h-7 w-7 items-center justify-center rounded border border-factum-400/30 text-sm font-bold text-factum-400 font-mono">F</span>
          <h3 class="font-mono text-lg font-semibold text-zinc-100">factum-fic</h3>
          <span class="font-mono text-sm text-zinc-600">CLI Contabile Forfettari</span>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          {ficTiers.map((tier, i) => (
            <div class="animate-fade-up flex flex-col rounded-2xl border p-6 transition-all duration-200"
              class:list={{
                "border-zinc-800/60 border-t-2 border-t-factum-400 bg-deep-800 shadow-sm shadow-factum-500/10": tier.highlighted,
                "border-zinc-800/60 bg-deep-800 hover:border-zinc-600": !tier.highlighted,
              }}
              style={`animation-delay: ${i * 0.07 + 0.12}s`}>
              {tier.badge && (
                <span class="mb-4 font-mono text-xs font-medium uppercase tracking-wider"
                  class:list={{"text-factum-400": tier.highlighted, "text-zinc-600": !tier.highlighted}}>
                  {tier.badge}
                </span>
              )}
              <h4 class="text-xl font-semibold text-zinc-100">{tier.name}</h4>
              <p class="text-sm text-zinc-600">{tier.subtitle}</p>
              <div class="my-4">
                <span class="text-3xl font-bold tracking-tight text-zinc-100 font-mono">{tier.price}</span>
                <span class="ml-1.5 text-sm text-zinc-600 font-mono">{tier.priceSuffix}</span>
              </div>
              <p class="mb-5 text-sm leading-relaxed text-zinc-500">{tier.description}</p>
              <ul class="mb-8 space-y-2.5 text-sm" role="list">
                {tier.features.map((f) => (
                  <li class="flex items-start gap-2.5 text-zinc-400">
                    <svg class="mt-0.5 h-4 w-4 shrink-0 text-factum-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
              <a href={tier.ctaHref}
                class="mt-auto inline-flex w-full items-center justify-center gap-1.5 rounded-xl py-2.5 text-center font-mono text-sm font-medium transition-all"
                class:list={{
                  "bg-factum-400 text-deep-900 hover:bg-factum-300 font-semibold": tier.highlighted,
                  "border border-zinc-800 text-zinc-400 hover:border-zinc-600 hover:text-zinc-200": !tier.highlighted,
                }}>
                {tier.cta}
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Note -->
    <div class="mx-auto mt-12 max-w-4xl animate-fade-up rounded-2xl border border-zinc-800/60 bg-deep-800 px-6 py-5 text-center" style="animation-delay: 0.5s">
      <p class="font-mono text-base text-zinc-400">
        <span class="text-factum-400 font-semibold">💡</span> XML FatturaPA: <span class="text-zinc-200 font-medium">€0 — illimitate</span>
        · Elaborazione 100% sul tuo computer
      </p>
      <p class="mt-1.5 text-sm text-zinc-600">
        Hai una Partita IVA? Inseriscila nel checkout Lemon Squeezy per ricevere la fattura elettronica.
      </p>
    </div>
  </div>
</section>