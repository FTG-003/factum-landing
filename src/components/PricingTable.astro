---
// === PricingTable (v2) — Dual-column: Factum API + factum-fic ===
// Stile industrial-tech, bordi zinc-800, CTA Lemon Squeezy diretti

import type { PricingTier } from "../data/pricing";

export interface Props {
  apiTiers: PricingTier[];
  ficTiers: PricingTier[];
}
const { apiTiers, ficTiers } = Astro.props;
---

<section id="pricing" class="relative border-t border-zinc-800 py-24 md:py-32">
  <div class="pointer-events-none absolute inset-0 bg-geo opacity-20" aria-hidden="true" />

  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <span class="mb-3 inline-block font-mono text-[11px] font-medium uppercase tracking-[0.25em] text-factum-400">/pricing</span>
      <h2 class="font-serif-display text-3xl text-zinc-100 sm:text-4xl">
        Paghi solo quello che usi
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-zinc-500">
        Niente abbonamenti nascosti. Niente sales call. Prezzi reali, uguali per tutti.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      <!-- ── FACTUM API ── -->
      <div>
        <div class="mb-4 flex items-center gap-2">
          <span class="flex h-5 w-5 items-center justify-center rounded border border-factum-400/30 text-[10px] font-bold text-factum-400 font-mono">A</span>
          <h3 class="font-mono text-sm font-semibold text-zinc-100">Factum API</h3>
          <span class="font-mono text-[11px] text-zinc-600">AI Document Parser</span>
        </div>
        <div class="grid gap-3 sm:grid-cols-3">
          {apiTiers.map((tier, i) => (
            <div
              class="animate-fade-up flex flex-col rounded-xl border p-5 transition-all duration-200"
              class:list={{
                "border-zinc-800 border-t-2 border-t-factum-400 bg-[#12161f]": tier.highlighted,
                "border-zinc-800 bg-[#12161f] hover:border-zinc-600": !tier.highlighted,
              }}
              style={`animation-delay: ${i * 0.07}s`}
            >
              {tier.badge && (
                <span
                  class="mb-3 font-mono text-[10px] font-medium uppercase tracking-wider"
                  class:list={{
                    "text-factum-400": tier.highlighted,
                    "text-zinc-600": !tier.highlighted,
                  }}
                >
                  {tier.badge}
                </span>
              )}
              <h4 class="text-base font-semibold text-zinc-100">{tier.name}</h4>
              <p class="text-xs text-zinc-600">{tier.subtitle}</p>
              <div class="my-3">
                <span class="text-2xl font-bold tracking-tight text-zinc-100 font-mono">{tier.price}</span>
                <span class="ml-1 text-xs text-zinc-600 font-mono">{tier.priceSuffix}</span>
              </div>
              <p class="mb-4 text-xs leading-relaxed text-zinc-500">{tier.description}</p>
              <ul class="mb-6 space-y-2 text-xs" role="list">
                {tier.features.map((f) => (
                  <li class="flex items-start gap-2 text-zinc-400">
                    <svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-factum-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
              <a
                href={tier.ctaHref}
                class="mt-auto inline-flex w-full items-center justify-center gap-1.5 rounded-lg py-2 text-center font-mono text-xs font-medium transition-all"
                class:list={{
                  "bg-factum-400 text-[#12161f] hover:bg-factum-300": tier.highlighted,
                  "border border-zinc-800 text-zinc-400 hover:border-zinc-600 hover:text-zinc-200": !tier.highlighted,
                }}
              >
                {tier.cta}
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          ))}
        </div>
      </div>

      <!-- ── FACTUM-FIC ── -->
      <div>
        <div class="mb-4 flex items-center gap-2">
          <span class="flex h-5 w-5 items-center justify-center rounded border border-factum-400/30 text-[10px] font-bold text-factum-400 font-mono">F</span>
          <h3 class="font-mono text-sm font-semibold text-zinc-100">factum-fic</h3>
          <span class="font-mono text-[11px] text-zinc-600">CLI Contabile Forfettari</span>
        </div>
        <div class="grid gap-3 sm:grid-cols-3">
          {ficTiers.map((tier, i) => (
            <div
              class="animate-fade-up flex flex-col rounded-xl border p-5 transition-all duration-200"
              class:list={{
                "border-zinc-800 border-t-2 border-t-factum-400 bg-[#12161f]": tier.highlighted,
                "border-zinc-800 bg-[#12161f] hover:border-zinc-600": !tier.highlighted,
              }}
              style={`animation-delay: ${i * 0.07 + 0.12}s`}
            >
              {tier.badge && (
                <span
                  class="mb-3 font-mono text-[10px] font-medium uppercase tracking-wider"
                  class:list={{
                    "text-factum-400": tier.highlighted,
                    "text-zinc-600": !tier.highlighted,
                  }}
                >
                  {tier.badge}
                </span>
              )}
              <h4 class="text-base font-semibold text-zinc-100">{tier.name}</h4>
              <p class="text-xs text-zinc-600">{tier.subtitle}</p>
              <div class="my-3">
                <span class="text-2xl font-bold tracking-tight text-zinc-100 font-mono">{tier.price}</span>
                <span class="ml-1 text-xs text-zinc-600 font-mono">{tier.priceSuffix}</span>
              </div>
              <p class="mb-4 text-xs leading-relaxed text-zinc-500">{tier.description}</p>
              <ul class="mb-6 space-y-2 text-xs" role="list">
                {tier.features.map((f) => (
                  <li class="flex items-start gap-2 text-zinc-400">
                    <svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-factum-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
              <a
                href={tier.ctaHref}
                class="mt-auto inline-flex w-full items-center justify-center gap-1.5 rounded-lg py-2 text-center font-mono text-xs font-medium transition-all"
                class:list={{
                  "bg-factum-400 text-[#12161f] hover:bg-factum-300": tier.highlighted,
                  "border border-zinc-800 text-zinc-400 hover:border-zinc-600 hover:text-zinc-200": !tier.highlighted,
                }}
              >
                {tier.cta}
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Note -->
    <div class="mx-auto mt-10 max-w-3xl animate-fade-up rounded-lg border border-zinc-800 bg-[#12161f] px-5 py-4 text-center" style="animation-delay: 0.5s">
      <p class="font-mono text-sm text-zinc-400">
        <span class="text-factum-400">&#x1f4a1;</span> XML FatturaPA: <span class="text-zinc-200">&euro;0 &mdash; illimitate</span>
        &middot; Elaborazione 100% sul tuo computer
      </p>
      <p class="mt-1 text-xs text-zinc-600">
        Hai una Partita IVA? Inseriscila nel checkout Lemon Squeezy per ricevere la fattura elettronica.
      </p>
    </div>
  </div>
</section>