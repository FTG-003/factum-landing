---
// === PricingTable — Dual-column pricing: Factum API + factum-fic ===
// Lemon Squeezy checkout direct. Prezzi reali dai codebase.

import type { PricingTier } from "../data/pricing";

export interface Props {
  apiTiers: PricingTier[];
  ficTiers: PricingTier[];
}
const { apiTiers, ficTiers } = Astro.props;
---

<section id="pricing" class="relative border-t border-white/5 py-20 md:py-28">
  <div class="pointer-events-none absolute inset-0 bg-grid-subtle opacity-20" aria-hidden="true" />

  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
    <!-- Header -->
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <span class="mb-4 inline-block text-xs font-medium uppercase tracking-[0.2em] text-factum-400">Prezzi</span>
      <h2 class="text-2xl font-bold text-zinc-100 sm:text-3xl">
        Paghi solo quello che usi
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-zinc-500">
        Niente abbonamenti nascosti. Niente sales call. Prezzi trasparenti, uguali per tutti.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      <!-- ── FACTUM API ── -->
      <div>
        <div class="mb-4 flex items-center gap-2">
          <span class="flex h-5 w-5 items-center justify-center rounded bg-factum-500/10 text-[10px] font-bold text-factum-400">A</span>
          <h3 class="text-sm font-semibold text-zinc-100">Factum API</h3>
          <span class="text-xs text-zinc-600">AI Document Parser</span>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          {apiTiers.map((tier, i) => (
            <div
              class="animate-fade-up relative flex flex-col rounded-xl border p-5 transition-all duration-300"
              class:list={{
                "border-factum-500/30 bg-factum-500/5": tier.highlighted,
                "border-white/5 bg-deep-800/30 hover:border-white/10": !tier.highlighted,
                "shadow-lg shadow-factum-500/5": tier.highlighted,
              }}
              style={`animation-delay: ${i * 0.08}s`}
            >
              {tier.badge && (
                <span
                  class="absolute -top-2.5 right-3 rounded-full px-2.5 py-0.5 text-[10px] font-medium"
                  class:list={{
                    "bg-factum-500 text-deep-900": tier.highlighted,
                    "bg-zinc-700 text-zinc-300": !tier.highlighted,
                  }}
                >
                  {tier.badge}
                </span>
              )}

              <h4 class="text-base font-semibold text-zinc-100">{tier.name}</h4>
              <p class="mb-1 text-xs text-zinc-600">{tier.subtitle}</p>
              <div class="mb-3">
                <span class="text-2xl font-bold tracking-tight text-zinc-100">{tier.price}</span>
                <span class="ml-1 text-xs text-zinc-600">{tier.priceSuffix}</span>
              </div>
              <p class="mb-4 text-xs leading-relaxed text-zinc-500">{tier.description}</p>

              <ul class="mb-6 space-y-2 text-xs" role="list">
                {tier.features.map((f) => (
                  <li class="flex items-start gap-2 text-zinc-400">
                    <svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-factum-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>

              <a
                href={tier.ctaHref}
                class="mt-auto inline-flex w-full items-center justify-center gap-1.5 rounded-lg py-2 text-center text-xs font-medium transition-all"
                class:list={{
                  "bg-factum-500 text-deep-900 hover:bg-factum-400": tier.highlighted,
                  "border border-white/10 text-zinc-300 hover:border-factum-500/30 hover:text-factum-300": !tier.highlighted,
                }}
              >
                {tier.cta}
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
                </svg>
              </a>
            </div>
          ))}
        </div>
      </div>

      <!-- ── FACTUM-FIC ── -->
      <div>
        <div class="mb-4 flex items-center gap-2">
          <span class="flex h-5 w-5 items-center justify-center rounded bg-factum-500/10 text-[10px] font-bold text-factum-400">F</span>
          <h3 class="text-sm font-semibold text-zinc-100">factum-fic</h3>
          <span class="text-xs text-zinc-600">CLI Contabile Forfettari</span>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          {ficTiers.map((tier, i) => (
            <div
              class="animate-fade-up relative flex flex-col rounded-xl border p-5 transition-all duration-300"
              class:list={{
                "border-factum-500/30 bg-factum-500/5": tier.highlighted,
                "border-white/5 bg-deep-800/30 hover:border-white/10": !tier.highlighted,
                "shadow-lg shadow-factum-500/5": tier.highlighted,
              }}
              style={`animation-delay: ${i * 0.08 + 0.15}s`}
            >
              {tier.badge && (
                <span
                  class="absolute -top-2.5 right-3 rounded-full px-2.5 py-0.5 text-[10px] font-medium"
                  class:list={{
                    "bg-factum-500 text-deep-900": tier.highlighted,
                    "bg-zinc-700 text-zinc-300": !tier.highlighted,
                  }}
                >
                  {tier.badge}
                </span>
              )}

              <h4 class="text-base font-semibold text-zinc-100">{tier.name}</h4>
              <p class="mb-1 text-xs text-zinc-600">{tier.subtitle}</p>
              <div class="mb-3">
                <span class="text-2xl font-bold tracking-tight text-zinc-100">{tier.price}</span>
                <span class="ml-1 text-xs text-zinc-600">{tier.priceSuffix}</span>
              </div>
              <p class="mb-4 text-xs leading-relaxed text-zinc-500">{tier.description}</p>

              <ul class="mb-6 space-y-2 text-xs" role="list">
                {tier.features.map((f) => (
                  <li class="flex items-start gap-2 text-zinc-400">
                    <svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-factum-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>

              <a
                href={tier.ctaHref}
                class="mt-auto inline-flex w-full items-center justify-center gap-1.5 rounded-lg py-2 text-center text-xs font-medium transition-all"
                class:list={{
                  "bg-factum-500 text-deep-900 hover:bg-factum-400": tier.highlighted,
                  "border border-white/10 text-zinc-300 hover:border-factum-500/30 hover:text-factum-300": !tier.highlighted,
                  "bg-white/5 text-zinc-400 hover:bg-white/10": tier.price === "€0" && !tier.highlighted,
                }}
              >
                {tier.cta}
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
                </svg>
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- factum-fic pricing detail -->
    <div class="mx-auto mt-10 max-w-3xl animate-fade-up rounded-xl border border-white/5 bg-deep-800/20 p-5 text-center text-sm" style="animation-delay: 0.6s">
      <p class="text-zinc-400">
        <span class="font-semibold text-factum-400">💡 10 PDF al mese bastano per oltre l'80% dei forfettari.</span>
        <br class="sm:hidden" />{" "}
        Hosting, dominio, AI, SaaS vari. Se stai iniziando, molto probabilmente non spenderai mai un centesimo.
      </p>
      <p class="mt-2 text-xs text-zinc-600">
        XML FatturaPA: <span class="font-mono text-zinc-400">€0 — gratis e illimitate</span>
        . Elaborazione 100% sul tuo computer.
      </p>
    </div>
  </div>
</section>