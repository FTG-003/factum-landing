---
// === Base Layout — Dark only, Fraunces/Inter/IBM Plex Mono ===

import "../styles/global.css";
import CookieConsent from "../components/CookieConsent.astro";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noCookie?: boolean;
}

const {
  title = "Factum — AI Document Parser & factum-fic CLI",
  description = "Parsing e analisi logica per agenti IA. Gestione contabile forfettari via CLI. Zero compromessi.",
  ogImage = "/og-image.webp",
  noCookie = false,
} = Astro.props;
---

<!doctype html>
<html lang="it" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&family=Fraunces:ital,wght@0,400..600;1,400..600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />

    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.9/dist/cdn.min.js" crossorigin="anonymous"></script>
  </head>

  <body class="min-h-screen bg-deep-900 text-zinc-100 font-sans antialiased">
    <slot />

    {!noCookie && <CookieConsent />}

    <!-- Footer → copiato dal docsite factum-parse (CustomFooter.astro) -->
    <footer class="border-t border-deep-600 bg-deep-900">
      <div class="mx-auto max-w-7xl px-6 py-16 text-center lg:px-8">
        <!-- legal-line -->
        <p class="mb-3 font-mono text-sm font-semibold text-zinc-300">
          &copy; {new Date().getFullYear()} Fabrizio Terzi — P.IVA IT04923300166
        </p>

        <!-- legal-links -->
        <nav class="mb-3 flex items-center justify-center gap-x-3 gap-y-1 flex-wrap font-mono text-sm text-zinc-500">
          <a href="/privacy/" class="transition-colors hover:text-zinc-200 hover:underline">Privacy Policy</a>
          <span class="text-zinc-600 select-none">·</span>
          <a href="/cookies/" class="transition-colors hover:text-zinc-200 hover:underline">Cookie Policy</a>
          <span class="text-zinc-600 select-none">·</span>
          <a href="/terms/" class="transition-colors hover:text-zinc-200 hover:underline">Termini di Servizio</a>
          <span class="text-zinc-600 select-none">·</span>
          <button id="manage-cookie-footer" type="button" class="transition-colors hover:text-zinc-200 hover:underline cursor-pointer">Gestisci Cookie</button>
          <span class="text-zinc-600 select-none">·</span>
          <a href="https://www.linkedin.com/in/bergamohub001/" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-zinc-200 hover:underline">LinkedIn</a>
          <span class="text-zinc-600 select-none">·</span>
          <a href="mailto:info@pyragogy.org" class="transition-colors hover:text-zinc-200 hover:underline">info@pyragogy.org</a>
        </nav>

        <!-- Zero Data Retention badge -->
        <div class="mb-3">
          <span class="inline-block rounded-xl border border-factum-400/20 px-3 py-1.5 font-mono text-xs text-factum-400">&empty; Zero Data Retention</span>
        </div>

        <!-- legal-note -->
        <p class="font-mono text-xs text-zinc-600 opacity-70">
          Pagamenti e fatturazione gestiti in sicurezza da Lemon Squeezy (Merchant of Record).
        </p>
      </div>
    </footer>

    {!noCookie && (
      <script type="module">
        document.getElementById('manage-cookie-footer')?.addEventListener('click', (e) => {
          e.preventDefault();
          window.__cc?.showPreferences?.();
        });
      </script>
    )}
  </body>
</html>