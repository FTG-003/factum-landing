---
// === Base Layout — Dark only, Fraunces/Inter/IBM Plex Mono ===

import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Factum — AI Document Parser & factum-fic CLI",
  description = "Parsing e analisi logica per agenti IA. Gestione contabile forfettari via CLI. Zero compromessi.",
  ogImage = "/og-image.webp",
} = Astro.props;
---

<!doctype html>
<html lang="it" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&family=Fraunces:ital,wght@0,400..600;1,400..600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />

    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.9/dist/cdn.min.js" crossorigin="anonymous"></script>
  </head>

  <body class="min-h-screen bg-deep-900 text-zinc-100 font-sans antialiased">
    <slot />

    <!-- Footer -->
    <footer class="border-t border-zinc-800/60 bg-deep-950">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="flex flex-col items-center justify-between gap-5 py-10 sm:flex-row">
          <div class="flex items-center gap-5 font-mono text-sm text-zinc-600">
            <span class="text-factum-400">&copy; {new Date().getFullYear()}</span>
            <span class="text-zinc-700">|</span>
            <a href="https://github.com/FTG-003/factum-fic" class="transition-colors hover:text-zinc-400">AGPL-3.0</a>
            <span class="text-zinc-700">|</span>
            <a href="https://docs.factum.pyragogy.org/privacy" class="transition-colors hover:text-zinc-400">ZDR Policy</a>
            <span class="text-zinc-700">|</span>
            <a href="mailto:info@pyragogy.org" class="transition-colors hover:text-zinc-400">info@pyragogy.org</a>
          </div>
          <div class="flex items-center gap-3 font-mono text-xs">
            <span class="rounded-xl border border-zinc-800/60 px-3 py-1.5 text-zinc-500">Pyragogy</span>
            <span class="rounded-xl border border-factum-400/20 px-3 py-1.5 text-factum-400">&empty; Zero Data Retention</span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>